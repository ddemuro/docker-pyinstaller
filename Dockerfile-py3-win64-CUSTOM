# =============================================================================
# Stage 1 - bootloader-builder
#
# "-CUSTOM" means the image ships a PyInstaller bootloader that is COMPILED FROM
# SOURCE inside the image, not the upstream prebuilt binary that comes in the pip
# wheel. This stage downloads the *source* sdist for the pinned PyInstaller
# version and compiles the Windows bootloader with a real MSVC toolchain
# (cl.exe/link.exe running under wine via msvc-wine). The freshly built binaries
# are provably different from the wheel's - the final stage enforces that.
#
# The bootloader source version is pinned to PYINSTALLER_VERSION, the exact same
# version the final stage pip-installs. A mismatched bootloader/PyInstaller pair
# produces executables that crash at launch (PKG cookie + TOC layout must match),
# so the two MUST stay equal - see the guard in the final stage.
# =============================================================================
FROM ubuntu:24.04 AS bootloader-builder

ENV DEBIAN_FRONTEND noninteractive
ENV WINEARCH win64
ENV WINEDEBUG fixme-all

# Must equal the PYINSTALLER_VERSION pip-installed in the final stage.
ARG PYINSTALLER_VERSION=6.13.0
# msvc-wine is x64-hosted; win64 targets x64.
ARG MSVC_ARCH=x64
ARG PYI_TARGET_ARCH=64bit

# Prerequisites for msvc-wine + waf. ca-certificates must exist before we hit the
# winehq HTTPS repo below.
RUN set -x \
    && apt-get update -qy \
    && apt-get install --no-install-recommends -qfy \
       ca-certificates python3 python3-pip xz-utils msitools \
    && apt-get clean

# winehq-staging (needed to run cl.exe/link.exe under wine). The signing key is
# vendored (installers/winehq.key) and wired via signed-by, so no network key
# fetch is required and apt uses the modern keyring mechanism.
COPY installers/winehq.key /etc/apt/keyrings/winehq-archive.key
RUN set -x \
    && dpkg --add-architecture i386 \
    && echo 'deb [signed-by=/etc/apt/keyrings/winehq-archive.key] https://dl.winehq.org/wine-builds/ubuntu/ noble main' \
       > /etc/apt/sources.list.d/winehq.list \
    && apt-get update -qy \
    && apt-get install --no-install-recommends -qfy winehq-staging winbind \
    && apt-get clean

# Real MSVC (cl.exe/link.exe) running under wine. Host is always x64; the target
# architecture (x64 or the x86 cross) is selected by MSVC_ARCH.
COPY msvc-wine/ /opt/msvc-src/
RUN set -x \
    && cd /opt/msvc-src \
    && PYTHONUNBUFFERED=1 ./vsdownload.py --accept-license --dest /opt/msvc \
        --host-arch x64 --architecture ${MSVC_ARCH} \
    && ./install.sh /opt/msvc \
    && cd / && rm -rf /opt/msvc-src \
    && printf '. /opt/msvc/bin/%s/msvcenv.sh\nexport DISTUTILS_USE_SDK=1 MSSdk=1\n' "${MSVC_ARCH}" > /opt/msvc/activate.sh

# Compile the bootloader from the pinned sdist. Produces:
#   /out/bootloader/<Windows-XXbit-intel>/{run,runw,run_d,runw_d}.exe
#   /out/bootloader-manifest.json
COPY installers/bootloader-build.sh /usr/local/bin/bootloader-build.sh
RUN chmod +x /usr/local/bin/bootloader-build.sh \
    && MSVC_ARCH=${MSVC_ARCH} PYINSTALLER_VERSION=${PYINSTALLER_VERSION} PYI_TARGET_ARCH=${PYI_TARGET_ARCH} \
       /usr/local/bin/bootloader-build.sh


# =============================================================================
# Stage 2 - the CUSTOM runtime image (Python-in-wine + self-compiled bootloader)
# =============================================================================
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND noninteractive

ARG WINE_VERSION=winehq-staging
ARG PYTHON_VERSION=3.9.9
# MUST match the bootloader-builder stage above (same source == same version).
ARG PYINSTALLER_VERSION=6.13.0

# wine settings
ENV WINEARCH win64
ENV WINEDEBUG fixme-all
ENV WINEPREFIX /wine

# xvfb settings
# from https://github.com/engineervix/docker-pyinstaller/blob/b99163b6eb0a81fc9a0bfd498c09c4e0253d01b2/Dockerfile-py3-win64#L56-L59
ENV DISPLAY :0
RUN set -x \
    && echo 'Xvfb $DISPLAY -screen 0 1024x768x24 &' >> /root/.bashrc

# PYPI repository location
ENV PYPI_URL=https://pypi.python.org/
# PYPI index location
ENV PYPI_INDEX_URL=https://pypi.python.org/simple

ENV W_DRIVE_C=/wine/drive_c
ENV W_WINDIR_UNIX="$W_DRIVE_C/windows"
ENV W_SYSTEM64_DLLS="$W_WINDIR_UNIX/system32"
ENV W_TMP="$W_DRIVE_C/windows/temp/_$0"

# we need wine for this all to work, so we'll use the PPA
RUN set -x \
    && dpkg --add-architecture i386 \
    && apt-get update -qy \
    && apt-get install --no-install-recommends -qfy apt-transport-https software-properties-common wget xvfb xdotool x11-utils xterm gpg-agent rename python3-tk rsync \
    && wget -nv https://dl.winehq.org/wine-builds/winehq.key \
    && apt-key add winehq.key \
    && add-apt-repository 'https://dl.winehq.org/wine-builds/ubuntu/' \
    && apt-get update -qy \
    && apt-get install --no-install-recommends -qfy $WINE_VERSION winbind cabextract \
    && apt-get clean \
    && wget -nv https://raw.githubusercontent.com/Winetricks/winetricks/master/src/winetricks \
    && chmod +x winetricks \
    && mv winetricks /usr/local/bin

# Copy the python installer files
COPY ./installers/python-${PYTHON_VERSION}/amd64/ ./
COPY ./installers/vc_redist.x64.exe vc_redist.x64.exe

# install python in wine, using the msi packages to install, extracting
# the files directly, since installing isn't running correctly.
RUN set -x \
    && winetricks win7 \
    && for msifile in `echo core dev exe lib path pip tcltk appendpath freethreaded test ucrt`; do \
        wine msiexec /i "${msifile}.msi" /qb TARGETDIR=C:/Python; \
        rm ${msifile}.msi; \
    done \
    && cd /wine/drive_c/Python \
    && ls -la /wine/drive_c/Python \
    && wine 'C:\Python\python.exe' -m pip install -U pip \
    && echo 'wine '\''C:\Python\python.exe'\'' "$@"' > /usr/bin/python \
    && echo 'wine '\''C:\Python\Scripts\easy_install.exe'\'' "$@"' > /usr/bin/easy_install \
    && echo 'wine '\''C:\Python\Scripts\pip.exe'\'' "$@"' > /usr/bin/pip \
    && echo 'wine '\''C:\Python\Scripts\pyinstaller.exe'\'' "$@"' > /usr/bin/pyinstaller \
    && echo 'wine '\''C:\Python\Scripts\pyupdater.exe'\'' "$@"' > /usr/bin/pyupdater \
    && echo 'assoc .py=PythonScript' | wine cmd \
    && echo 'ftype PythonScript=c:\Python\python.exe "%1" %*' | wine cmd \
    && while pgrep wineserver >/dev/null; do echo "Waiting for wineserver"; sleep 2; done \
    && chmod +x /usr/bin/python /usr/bin/easy_install /usr/bin/pip /usr/bin/pyinstaller /usr/bin/pyupdater \
    && (pip install -U pip || true) \
    && /usr/bin/pip install --upgrade pip || true \
    && /usr/bin/pip install --upgrade setuptools || true \
    && rm -rf /tmp/.wine-*

# install Microsoft Visual C++ Redistributable for Visual Studio 2017 dll files
RUN set -x \
    && rm -f "$W_TMP"/* \
    && mkdir -p "$W_TMP" \
    && mv vc_redist.x64.exe "$W_TMP"/vc_redist.x64.exe \
    && cabextract -q --directory="$W_TMP" "$W_TMP"/vc_redist.x64.exe \
    && ls -la "$W_TMP" \
    # Extract for each folder in $W_TMP
    &&for i in "$W_TMP"/*; do \
        cabextract -q --directory="$W_TMP" "$i"; \
    done \
    && cd "$W_TMP" \
    && rename 's/_/\-/g' *.dll \
    && cp "$W_TMP"/*.dll "$W_SYSTEM64_DLLS"/

# install pyinstaller (stock wheel) then overlay the SELF-COMPILED bootloader
# built in stage 1. The guard below makes the old silent no-op impossible.
COPY --from=bootloader-builder /out/bootloader/ /custom-bootloader/
COPY --from=bootloader-builder /out/bootloader-manifest.json /bootloader-manifest.json

ENV BL_DIR=/wine/drive_c/Python/Lib/site-packages/PyInstaller/bootloader

RUN set -eux \
    && /usr/bin/pip install pyinstaller==$PYINSTALLER_VERSION \
    # --- version-pin guard (step 3): the compiled bootloader and the installed
    #     PyInstaller MUST be the same version, or frozen apps crash at launch. ---
    && MANIFEST_VER="$(grep -oP '"pyinstaller_version":\s*"\K[^"]+' /bootloader-manifest.json)" \
    && test "$MANIFEST_VER" = "$PYINSTALLER_VERSION" \
        || { echo "ERROR: bootloader built for '$MANIFEST_VER' but image pins '$PYINSTALLER_VERSION'"; exit 1; } \
    && test -n "$(find /wine/drive_c/Python/Lib/site-packages -maxdepth 1 -iname "pyinstaller-${PYINSTALLER_VERSION}.dist-info" -print -quit)" \
        || { echo "ERROR: pip did not install PyInstaller==${PYINSTALLER_VERSION}"; exit 1; } \
    # --- snapshot the STOCK (upstream wheel) bootloaders before overlaying ---
    && mkdir -p /stock-bootloader \
    && cp -a "$BL_DIR/." /stock-bootloader/ \
    # --- overlay the freshly self-compiled bootloaders ---
    && cp -a /custom-bootloader/. "$BL_DIR/" \
    # --- fail-on-equal guard (step 2): every shipped exe MUST differ from the
    #     stock wheel's, otherwise "custom" is a no-op. ---
    && for f in "$BL_DIR"/Windows-*-intel/*.exe; do \
         rel="${f#"$BL_DIR"/}"; stock="/stock-bootloader/$rel"; \
         c="$(md5sum "$f" | cut -d' ' -f1)"; \
         if [ -f "$stock" ]; then \
             s="$(md5sum "$stock" | cut -d' ' -f1)"; \
             echo "bootloader $rel: custom=$c stock=$s"; \
             test "$c" != "$s" \
                 || { echo "ERROR: $rel is byte-identical to the stock wheel bootloader (custom build is a NO-OP)"; exit 1; }; \
         else \
             echo "bootloader $rel: custom=$c (no stock counterpart)"; \
         fi; \
       done \
    && echo "=== self-compiled bootloader manifest ===" \
    && cat /bootloader-manifest.json \
    && rm -rf /custom-bootloader /stock-bootloader

RUN /usr/bin/pip install pywin32 \
    && /usr/bin/pip install tk \
    && /usr/bin/pip install tcl \
    && /usr/bin/pip install pystray

# put the src folder inside wine
RUN mkdir /src/ && ln -s /src /wine/drive_c/src
VOLUME /src/
WORKDIR /wine/drive_c/src/
RUN mkdir -p /wine/drive_c/tmp

COPY entrypoint-windows.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
